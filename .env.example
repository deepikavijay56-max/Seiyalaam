# ─────────────────────────────────────────────────────────────
# Seiyalaam – Environment Configuration
# Copy this file to .env.local and fill in your values.
# IMPORTANT: NEVER commit service-role keys or secrets to frontend files.
# ─────────────────────────────────────────────────────────────

# Supabase API (Required for authentication and cloud sync)
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Google Gemini API (Server-Side Edge Function Secret)
# For security, do NOT expose API keys to the browser.
# Set in Supabase: Supabase CLI `supabase secrets set GEMINI_API_KEY=your_key` or Dashboard -> Project Settings -> Edge Functions -> Secrets
# GEMINI_API_KEY=your-gemini-api-key-here